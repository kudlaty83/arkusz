# Opcjonalnie skopiuj do .env i wpisz własną BEZWZGLĘDNĄ ścieżkę.
# Bez APP_DATA_DIR na Linuksie/macOS używany jest katalog $PWD/app_data.
# APP_DATA_DIR=/srv/arkusz/app_data
# Windows / Docker Desktop: np. APP_DATA_DIR=C:/Arkusz/app_data
APP_PORT=8080
# Pierwsze hasło administratora: <APP_DATA_DIR>/config/admin-password.
# Opcjonalny przykład wyłącznie przy inicjalizacji pustej bazy testowej:
# SEED_DEMO=1
